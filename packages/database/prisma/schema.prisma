generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SourceKind {
  official_page
  registration_page
  organizer_page
  aggregator
}

enum SourceStatus {
  active
  paused
  error
}

enum EventStatus {
  scheduled
  postponed
  cancelled
  sold_out
  finished
  unknown
}

enum PublicationStatus {
  draft
  pending_review
  published
  hidden
  rejected
}

enum Modality {
  road
  trail
  mixed
  kids
  walk
  unknown
}

enum DedupeStatus {
  unique
  possible_duplicate
  duplicate
  needs_review
}

enum ExtractionJobStatus {
  pending
  processing
  success
  validation_failed
  provider_failed
  manual_review
}

enum CurationStatus {
  not_curated
  curated
  failed
  skipped_cached
  manual_review
}

enum CurationJobStatus {
  pending
  processing
  success
  validation_failed
  provider_failed
  skipped_cached
  manual_review
}

model Source {
  id              String                @id @default(cuid())
  name            String
  url             String
  type            SourceKind
  country         String?
  state           String?
  city            String?
  status          SourceStatus          @default(active)
  adapter         String?
  externalId      String?
  metadata        Json?
  checkIntervalMinutes Int?
  lastHash        String?
  lastCheckedAt   DateTime?
  lastSuccessAt   DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  events          Event[]
  rawExtractions  RawSourceExtraction[]
  extractionJobs  ExtractionJob[]
  eventReferences EventSourceReference[]

  @@unique([adapter, externalId])
}

model RawSourceExtraction {
  id               String   @id @default(cuid())
  sourceId         String
  source           Source   @relation(fields: [sourceId], references: [id])
  sourceType       String
  sourceExternalId String?
  url              String
  contentHash      String
  title            String?
  importantHtml    String   @db.Text
  importantText    String   @db.Text
  rawSourceData    Json
  extractedLinks   Json
  adapter          String
  adapterVersion   String
  fetchedAt        DateTime
  createdAt        DateTime @default(now())
  curationJobs     CurationJob[]

  @@index([sourceId])
  @@index([contentHash])
}

model ImportRun {
  id                 String   @id
  source             String
  quickFilter        String
  status             String
  requestedQuantity  Int
  offset             Int      @default(0)
  discoveredCount    Int
  processedCount     Int
  publishedEvents    Int
  manualReviewEvents Int
  unchangedEvents    Int
  failedCount        Int
  failures           Json
  startedAt          DateTime
  finishedAt         DateTime
  createdAt          DateTime @default(now())
  mode               String   @default("apply")
  cursor             Int      @default(0)
  candidateLimit     Int?
  options            Json     @default("{}")
  candidates         ImportCandidate[]

  @@index([source, createdAt])
}

model ImportCandidate {
  id                 String    @id @default(cuid())
  importRunId        String
  importRun          ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  sourceType         String
  sourceExternalId   String
  sourceUrl          String
  name               String
  date               DateTime?
  city               String?
  state              String?
  status             String    @default("pending")
  action             String    @default("create")
  matchEventId       String?
  matchScore         Float?
  proposedEvent      Json?
  displayPreview     Json?
  provenance         Json      @default("{}")
  warnings           Json      @default("[]")
  errorMessage       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([importRunId, sourceType, sourceExternalId])
  @@index([importRunId, status])
  @@index([sourceType, sourceExternalId])
}

model Event {
  id                  String            @id @default(cuid())
  slug                String            @unique
  name                String
  description         String?           @db.Text
  date                DateTime?
  startTime           String?
  endTime             String?
  city                String?
  state               String?
  country             String?
  locationName        String?
  address             String?
  latitude            Float?
  longitude           Float?
  modality            Modality          @default(unknown)
  eventStatus         EventStatus       @default(unknown)
  publicationStatus   PublicationStatus @default(draft)
  administrativeReview Boolean @default(false)
  registrationUrl     String?
  officialUrl         String?
  regulationUrl       String?
  organizerName       String?
  organizerUrl        String?
  mainImageUrl        String?
  sourceId            String?
  source              Source?           @relation(fields: [sourceId], references: [id])
  sourceType          String?
  sourceExternalId    String?
  sourceUrl           String?
  confidence          Float             @default(0)
  curationStatus      CurationStatus    @default(not_curated)
  curatedAt           DateTime?
  curationProvider    String?
  curationModel       String?
  curationVersion     String?
  canonicalFingerprint String
  dedupeStatus        DedupeStatus      @default(unique)
  duplicateOfEventId  String?
  warnings            Json
  publishabilityReasons Json
  publishedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  distances           EventDistance[]
  prices              EventPrice[]
  kits                EventKit[]
  kitPickups          EventKitPickup[]
  schedule            EventSchedule[]
  rules               EventRule[]
  images              EventImage[]
  versions            EventVersion[]
  extractionJobs      ExtractionJob[]
  curationJobs        CurationJob[]
  sourceReferences    EventSourceReference[]
  resultSets          ResultSet[]
  exports             ExportArtifact[]

  @@index([publicationStatus])
  @@index([date])
  @@index([city, state, country])
  @@index([canonicalFingerprint])
  @@unique([sourceType, sourceExternalId])
}

model EventSourceReference {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sourceId         String
  source            Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceType       String
  sourceExternalId String
  url              String
  role             String   @default("supplemental")
  priority         Int      @default(50)
  contentHash      String?
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sourceType, sourceExternalId])
  @@unique([eventId, sourceId])
  @@index([eventId, priority])
}

model EventDistance {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label         String
  distanceKm    Float?
  modality      Modality @default(unknown)
  startTime     String?
  elevationGain Float?
  sourceText    String?  @db.Text
  confidence    Float    @default(0)
}

model EventPrice {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String?
  price      Float?
  currency   String   @default("BRL")
  startDate  DateTime?
  endDate    DateTime?
  status     String   @default("unknown")
  isCurrent  Boolean  @default(false)
  sourceText String?  @db.Text
  confidence Float    @default(0)
}

model EventKit {
  id         String  @id @default(cuid())
  eventId    String
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String?
  items      Json
  price      Float?
  sourceText String? @db.Text
  confidence Float   @default(0)
}

model EventKitPickup {
  id                String   @id @default(cuid())
  eventId           String
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location          String?
  address           String?
  date              DateTime?
  startTime         String?
  endTime           String?
  requiredDocuments Json
  sourceText        String?  @db.Text
  confidence        Float    @default(0)
}

model EventSchedule {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date       DateTime?
  time       String?
  activity   String
  location   String?
  sourceText String?  @db.Text
  confidence Float    @default(0)
}

model EventRule {
  id         String  @id @default(cuid())
  eventId    String
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category   String
  text       String  @db.Text
  sourceText String? @db.Text
  confidence Float   @default(0)
}

model EventImage {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int    @default(0)
}

model EventVersion {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  schemaVersion   String
  curationVersion String
  snapshot        Json
  createdAt       DateTime @default(now())
}

model ExtractionJob {
  id              String              @id @default(cuid())
  sourceId        String
  source          Source              @relation(fields: [sourceId], references: [id])
  eventId         String?
  event           Event?              @relation(fields: [eventId], references: [id])
  provider        String?
  model           String?
  adapter         String?
  adapterVersion  String?
  schemaVersion   String?
  curationVersion String?
  inputHash       String?
  status          ExtractionJobStatus  @default(pending)
  rawInput        Json?
  rawOutput       Json?
  validatedJson   Json?
  normalizedJson  Json?
  confidence      Float?
  warnings        Json?
  reasons         Json?
  errorMessage    String?             @db.Text
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime            @default(now())

  @@index([sourceId])
  @@index([eventId])
  @@index([status])
}

model CurationJob {
  id                    String             @id @default(cuid())
  eventId               String?
  event                 Event?             @relation(fields: [eventId], references: [id])
  rawSourceExtractionId String?
  rawSourceExtraction   RawSourceExtraction? @relation(fields: [rawSourceExtractionId], references: [id])
  provider              String
  model                 String
  status                CurationJobStatus  @default(pending)
  contentHash           String
  schemaVersion         String
  curationVersion       String
  rawInput              Json?
  rawOutput             Json?
  validatedJson         Json?
  normalizedJson        Json?
  appliedChanges        Json?
  warnings              Json?
  confidence            Float?
  isDryRun              Boolean            @default(false)
  errorMessage          String?            @db.Text
  createdAt             DateTime           @default(now())
  finishedAt            DateTime?

  @@index([eventId])
  @@index([rawSourceExtractionId])
  @@index([provider, model, contentHash, schemaVersion, curationVersion, status])
  @@index([status])
}

// Event is an edition, never a global race or athlete identity.
model WorkerPresence {
  id           String @id
  runtime      String
  capabilities String[]
  state        String
  activeTaskId String?
  version      String
  startedAt    DateTime @default(now()) @db.Timestamptz(6)
  lastSeenAt   DateTime @default(now()) @db.Timestamptz(6)
  @@index([lastSeenAt])
}

model CollectionTask {
  id             String   @id @default(uuid())
  source         String
  kind           String
  status         String   @default("queued")
  ownerId        String
  idempotencyKey String
  requestHash    String
  payload        Json
  progress       Json     @default("{}")
  attempt        Int      @default(0)
  maxAttempts    Int      @default(3)
  leaseToken     String?
  leaseUntil     DateTime? @db.Timestamptz(3)
  availableAt    DateTime @default(now()) @db.Timestamptz(3)
  errorCode      String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)
  @@unique([ownerId, idempotencyKey])
  @@index([source, status, availableAt])
}

model SourceSlot {
  source String @id
}

model ResultSet {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  source     String
  externalId String
  sourceUrl  String
  updatedAt  DateTime @default(now()) @db.Timestamptz(3)
  contentHash String
  count      Int
  disciplines RaceDiscipline[]
  results    RaceResult[]
  @@unique([source, externalId])
  @@index([eventId])
}

model RaceDiscipline {
  id          String @id @default(uuid())
  resultSetId String
  resultSet   ResultSet @relation(fields: [resultSetId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  distanceKm  Float?
  @@unique([resultSetId, externalId])
}

model RaceResult {
  id               String @id @default(uuid())
  resultSetId      String
  resultSet        ResultSet @relation(fields: [resultSetId], references: [id], onDelete: Cascade)
  recordKey        String
  modality         String
  gender           String?
  category         String?
  bib              String?
  name             String
  team             String?
  overallPosition  Int?
  categoryPosition Int?
  time             String?
  pace             String?
  distanceKm       Float?
  gap              String?
  @@unique([resultSetId, recordKey])
  @@index([resultSetId, modality, overallPosition, id])
}

model ExportArtifact {
  id          String @id @default(uuid())
  eventId     String?
  event       Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  kind        String @default("results")
  selection   Json @default("{}")
  contentType String?
  ownerId     String
  taskId      String @unique
  status      String @default("queued")
  objectPath  String?
  expiresAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  @@index([expiresAt])
}

model SourceMatch {
  id         String @id @default(uuid())
  source     String
  externalId String
  url        String
  name       String
  date       DateTime? @db.Timestamptz(3)
  city       String?
  state      String?
  status     String @default("pending")
  eventId    String?
  resolvedBy String?
  updatedAt  DateTime @default(now()) @db.Timestamptz(3)
  @@unique([source, externalId])
  @@index([status])
}

model ApiCredential {
  id           String @id @default(uuid())
  name         String
  keyHash      String @unique
  scopes       String[]
  limitPerHour Int @default(1000)
  revokedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  usage        ApiUsage[]
}

model ApiUsage {
  credentialId String
  credential   ApiCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  window       DateTime @db.Timestamptz(3)
  count        Int @default(0)
  @@id([credentialId, window])
}

model CatalogSync {
 id String @id @default(uuid())
 source String
 ownerId String
 options Json
 snapshot Json @default("[]")
 cursor Int @default(0)
 page Int @default(1)
 status String @default("ready")
 coverage String @default("not_started")
 discovered Int @default(0)
 processed Int @default(0)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @db.Timestamptz(6)
}
model AdminAudit {
 id String @id @default(uuid())
 actorId String
 action String
 eventId String?
 taskId String?
 details Json @default("{}")
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 @@index([eventId,createdAt])
}
