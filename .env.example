NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/race_calendar?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/race_calendar?schema=public"
INTERNAL_API_KEY="dev-internal-key"
CORS_ORIGINS="*"

AI_PROVIDER=mock
AI_MODEL=mock-race-event-v1
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_CURATION_ENABLED=false
AI_CURATION_REQUIRED=false

AUTO_PUBLISH_MIN_CONFIDENCE=0.85
REVIEW_MIN_CONFIDENCE=0.60

SCRAPER_TIMEOUT_MS=15000
SCRAPER_MAX_RETRIES=3
SCRAPER_USER_AGENT="UniversalRaceCalendarBot/0.1"

TICKETSPORTS_IMPORT_QUANTITY=1000
TICKETSPORTS_IMPORT_OFFSET=0
TICKETSPORTS_IMPORT_QUICK_FILTER=corrida-de-rua
TICKETSPORTS_IMPORT_CONCURRENCY=3
TICKETSPORTS_IMPORT_DELAY_MS=300

CORRIDASBR_IMPORT_QUANTITY=5000
CORRIDASBR_IMPORT_OFFSET=0
CORRIDASBR_IMPORT_STATES=AC,AL,AM,AP,BA,CE,DF,ES,GO,MA,MG,MS,MT,PA,PB,PE,PI,PR,RJ,RN,RO,RR,RS,SC,SE,SP,TO
CORRIDASBR_IMPORT_CONCURRENCY=2
CORRIDASBR_IMPORT_DELAY_MS=500
OFFICIAL_PAGE_ENRICHMENT_ENABLED=true
IMPORT_SIMULATION_MAX_CANDIDATES=200
CATALOG_IMPORT_QUANTITY=5000

ADAPTER_VERSION_TICKETSPORTS=1.0.0
ADAPTER_VERSION_CORRIDASBR=1.0.0
ADAPTER_VERSION_OFFICIAL_PAGE=1.0.0
CANONICAL_SCHEMA_VERSION=1.0.0
CURATION_PIPELINE_VERSION=1.2.0
