FROM python:3.12-slim-bookworm
WORKDIR /app
COPY apps/openresults-worker/requirements*.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt && playwright install --with-deps chromium
COPY apps/openresults-worker/app ./app
COPY apps/openresults-worker/worker.py apps/openresults-worker/batch.py apps/openresults-worker/browser_smoke.py ./
COPY apps/openresults-worker/presence.py apps/openresults-worker/catalog_sync.py apps/openresults-worker/edition_metadata.py apps/openresults-worker/selection_export.py ./
COPY apps/openresults-worker/source_requests.py apps/openresults-worker/source_observation.py ./
# Check imports used at startup and deferred by inspection/export paths, without
# connecting to the database or a source. A successful image build must include them.
RUN python -c "import worker, catalog_sync, edition_metadata, selection_export"
RUN useradd --create-home runner && cp -r /root/.cache /home/runner/.cache && chown -R runner:runner /home/runner/.cache
USER runner
ENV PYTHONUNBUFFERED=1
CMD ["python","-m","worker"]
